# Copy to .env and set your site password (never commit .env).
# If SITE_PASSWORD is empty, dashboard auth is disabled.
SITE_PASSWORD=change-me

# Optional: cookie HMAC secret (defaults to SITE_PASSWORD)
# SESSION_SECRET=random-long-string

# Optional bind port for `python -m backend` (default 8010)
# PORT=8010

# Optional SQLite / encryption-key directory (default <repo>/data)
# DATA_DIR=

# Set to 1 to mark the login cookie Secure (also on when RAILWAY_ENVIRONMENT is set)
# FORCE_SECURE_COOKIES=1

# Wallet private key. Derives CLOB L2 creds for PolyBolt 60s TWAP if no /real account exists.
# Never commit the real value. Prefer adding the key via the /real Add Account UI.
# POLYMARKET_PRIVATE_KEY=

# Optional Builder API credentials for gasless redeem. All three must be set together.
# If unset, a deposit/proxy wallet can create and store a builder key at first redeem.
# POLYMARKET_BUILDER_API_KEY=
# POLYMARKET_BUILDER_SECRET=
# POLYMARKET_BUILDER_PASSPHRASE=

# Not used by the app (preflight script only): POLYMARKET_API_KEY / SECRET / PASSPHRASE
# Telegram is not implemented. There is no TELEGRAM_BOT_TOKEN.

