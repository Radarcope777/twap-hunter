# Copy to .env and set your site password (never commit .env).
SITE_PASSWORD=change-me
# Optional: separate signing secret (defaults to SITE_PASSWORD)
# SESSION_SECRET=random-long-string

# Wallet private key. The bot derives CLOB L2 creds via the SDK (PolyBolt 60s TWAP).
# Never commit the real value. Same env name as the official SDK example.
# POLYMARKET_PRIVATE_KEY=
